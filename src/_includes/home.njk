---
layout: base.njk
---
<ul class="entry-list" data-reveal>
  {% for entry in collections.entries | reverse %}
  <li class="entry-row">
    <a class="entry-title" href="{{ entry.url }}">{{ entry.data.title }}</a>
    <time class="entry-date" datetime="{{ entry.date | htmlDateString }}">{{ entry.data.date | readableDate }}</time>
  </li>
  {% endfor %}
</ul>

<footer class="site-footer">
  <div class="copyright">Arttu Kaitila &copy; {{ currentYear }}</div>
</footer>
